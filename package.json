{
  "name": "ai-js-appium-mcp",
  "version": "1.0.0",
  "description": "WebdriverIO project where AI coding agents write and run mobile UI tests through Appium MCP",
  "type": "commonjs",
  "license": "ISC",
  "scripts": {
    "verify": "wdio run wdio.conf.js",
    "test": "npm run verify",
    "clean": "find tests -maxdepth 1 -name \"*.test.js\" -delete && rm -rf test-results",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "tests/**/*.test.js": "eslint --fix",
    "*.{js,cjs}": "eslint"
  },
  "keywords": [
    "appium",
    "appium-mcp",
    "mcp",
    "webdriverio",
    "wdio",
    "mobile",
    "ios",
    "android",
    "automation",
    "ai"
  ],
  "author": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "chai": "^6.2.2",
    "dotenv": "^17.2.1",
    "eslint": "^10.6.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-wdio": "^9.31.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
