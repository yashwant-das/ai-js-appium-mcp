{
  "name": "appium-mcp-playground",
  "version": "1.0.0",
  "description": "AI-driven Appium MCP test framework - generate WDIO tests from markdown prompts",
  "main": "src/cli.js",
  "scripts": {
    "test": "wdio run wdio-reminders.conf.js",
    "test:all": "npm run test:reminders && npm run test:contacts && npm run test:safari",
    "test:reminders": "wdio run wdio-reminders.conf.js",
    "test:contacts": "wdio run wdio-contacts.conf.js",
    "test:safari": "wdio run wdio-safari.conf.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "generate": "node src/cli.js generate",
    "verify": "node src/cli.js verify",
    "verify:all": "node src/cli.js verify -c wdio-reminders.conf.js && node src/cli.js verify -c wdio-contacts.conf.js && node src/cli.js verify -c wdio-safari.conf.js",
    "verify:reminders": "node src/cli.js verify -c wdio-reminders.conf.js",
    "verify:contacts": "node src/cli.js verify -c wdio-contacts.conf.js",
    "verify:safari": "node src/cli.js verify -c wdio-safari.conf.js",
    "clean": "node src/cli.js clean"
  },
  "keywords": [
    "appium",
    "mcp",
    "webdriverio",
    "testing",
    "mobile"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.6"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^15.0.0"
  }
}
