{
  "name": "ai-js-appium-mcp",
  "version": "1.0.0",
  "description": "WebdriverIO project where AI coding agents write and run mobile UI tests through Appium MCP",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "wdio run wdio.conf.js",
    "test": "npm run verify",
    "clean": "find tests -maxdepth 1 -name \"*.test.js\" -delete && rm -rf test-results",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "appium": "appium"
  },
  "lint-staged": {
    "tests/**/*.test.js": "eslint --fix",
    "*.{js,cjs}": "eslint"
  },
  "keywords": [
    "appium",
    "appium-mcp",
    "mcp",
    "webdriverio",
    "wdio",
    "mobile",
    "ios",
    "android",
    "automation",
    "ai"
  ],
  "author": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wdio/allure-reporter": "^10.0.1",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "allure": "^3.20.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.18.1",
    "chai": "^6.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-wdio": "^10.0.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "axios": "^1.20.0",
    "shell-quote": "^1.11.0",
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "morgan": "^1.12.1",
    "brace-expansion@5": "^5.0.12"
  },
  "allowScripts": {
    "edgedriver": false,
    "geckodriver": false,
    "esbuild": false,
    "fsevents": false,
    "appium": false
  }
}
